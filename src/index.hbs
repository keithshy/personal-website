<!doctype html>
<html lang="en" data-theme="light">
  <head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>{{ name }}</title>
    <link href="https://cdn.jsdelivr.net/npm/daisyui@4.6.0/dist/full.css" rel="stylesheet" type="text/css">
    <link href="style.css" rel="stylesheet" type="text/css">
  </head>
  <body>
    <div class="mt-3 mx-auto md:max-w-7/8 xl:max-w-5/8">
      <div class="top-section flex flex-col md:flex-row">
        <div class="basis-2/3 p-4">
          <h1 class="title">{{ name }}</h1>
          <h2 class="subtitle">{{ title }}</h2>
        </div>
        <div class="basis-1/3 border-l-2 p-4">
          <p>{{ cellphone }}</p>
          <p class="break-all md:break-normal"><a href="mailto:{{ email }}">{{ email }}</a></p>
          <p class="break-all md:break-normal"><a target="_blank" href="https://{{ linkedin }}">{{ linkedin }}</a></p>
        </div>
      </div>
      <hr style="color: #2f6f9c; border-width: 2px;" />
      <div class="bottom-section flex flex-col md:flex-row">
        <div class="basis-2/3 p-4">
          <div class="content">
            <div class="section">
              <h4>SUMMARY</h4>
              <p>{{ summary }}</p>
            </div>
            <div class="section">
              <h4>PROFESSIONAL EXPERIENCE</h4>

              {{#each jobs}}
              <div class="subsection">
                <div class="job-header flex flex-row justify-between">
                  <div>
                    <p class="job-title">{{ this.title }}</p>
                    <p>{{ this.company }}</p>
                  </div>
                  <div class="job-dates">
                    {{ this.dates }}
                  </div>
                </div>
                <ul class="border-left">
                  {{#each this.bulletPoints}}
                  <li>{{ this }}</li>
                  {{/each}}
                </ul>
              </div>
              {{/each}}
            </div>
          </div>
        </div>
        <div class="basis-1/3 border-l-2 p-4" style="background: #e8eff5;">
          <div class="content">
            <div class="section">
              <h4>EDUCATION</h4>
              {{#each education}}
              <p><b>{{ this.degree }}</b></p>
              <p>
                {{ this.school }}<br/>
                {{ this.years }}
              </p>
              {{/each}}
            </div>

            <div class="section">
              <h4>HONORS</h4>
              <ul>
                {{#each honors}}
                <li>{{ this }}</li>
                {{/each}}
              </ul>
            </div>

            <div class="section">
              <h4>SKILLS</h4>
              {{#with skills}}
              <div class="subsection">
                <h5>LANGUAGES</h5>
                <p>{{ languages }}</p>
              </div>
              <div class="subsection">
                <h5>TECH STACK</h5>
                <p>{{ tech }}</p>
              </div>
              <div class="subsection">
                <ul>
                  {{#each bulletPoints}}
                  <li>{{ this }}</li>
                  {{/each}}
                </ul>
              </div>
              {{/with}}
            </div>
            <div class="section">
              <h4>PROJECT PORTFOLIO</h4>
              {{#each projects}}
              <div class="mb-1">
                <p><b>{{ this.title }}</b></p>
                <p class="text-sm">{{ this.description }}</p>
                <p class="text-sm">{{ this.languages }}</p>
                <p><a class="break-all" target="_blank" href="{{ this.href }}">{{ this.link }}</a></p>
              </div>
              {{/each}}
            </div>
          </div>
        </div>
      </div>
    </div>
  </body>
</html>
